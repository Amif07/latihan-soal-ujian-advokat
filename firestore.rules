rules_version='2';
service cloud.firestore { match /databases/{d}/documents {
  function isAdmin(){return get(/databases/$(d)/documents/users/$(request.auth.uid)).data.role=='admin';}
  match /users/{uid}{
    allow read: if request.auth!=null && (request.auth.uid==uid || isAdmin());
    allow create: if request.auth!=null && request.auth.uid==uid && request.resource.data.role=='user';
    allow update: if request.auth!=null && isAdmin();
  }
  match /questions/{id}{
    allow read: if request.auth!=null;
    allow write: if request.auth!=null && isAdmin();
  }
  match /results/{id}{
    allow create: if request.auth!=null && request.resource.data.uid==request.auth.uid;
    allow read: if request.auth!=null && (resource.data.uid==request.auth.uid || isAdmin());
  }
}}
